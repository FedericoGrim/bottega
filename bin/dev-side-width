#!/usr/bin/env bash
set -euo pipefail

main_tmux="$1"
main_pane="$2"
window_name="$3"

case "$window_name" in
  claude) width="30%" ;;
  opencode) width="35%" ;;
  lazygit) width="40%" ;;
  podman | docker) width="55%" ;;
  *) width="" ;;
esac

log_file="$HOME/.cache/dev/side-width.log"
mkdir -p "$(dirname "$log_file")"
echo "$(date +%T) window=$window_name width=${width:-none} pane=$main_pane" >>"$log_file"

if [ -n "$width" ]; then
  TMUX="$main_tmux" tmux resize-pane -t "$main_pane" -x "$width"
fi
