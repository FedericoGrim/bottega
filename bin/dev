#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: dev [options] [directory]

  --container            run the project in a dev container (created if missing)
  --agent NAME           main AI agent in the side panel: claude (default) or opencode
  --agent-in-container   run the agent inside the container instead of on the host
  -h, --help             show this help

Shortcuts: dev-container, dev-opencode
EOF
}

die() {
  echo "dev: $*" >&2
  exit 1
}

use_container=0
agent="claude"
agent_in_container=0

while [ $# -gt 0 ]; do
  case "$1" in
    --container) use_container=1 ;;
    --agent)
      agent="${2:?--agent needs a value}"
      shift
      ;;
    --agent-in-container) agent_in_container=1 ;;
    -h | --help)
      usage
      exit 0
      ;;
    --) shift; break ;;
    -*) die "unknown option: $1" ;;
    *) break ;;
  esac
  shift
done

case "$agent" in
  claude | opencode) ;;
  *) die "unknown agent: $agent (use claude or opencode)" ;;
esac

project_dir="$(realpath "${1:-$PWD}")"
session_name="$(basename "$project_dir" | tr '.:' '__')"
state_file="$HOME/.cache/dev/$session_name.json"

[ "$agent_in_container" = "1" ] && use_container=1
[ -f "$state_file" ] && use_container=1

if [ "$use_container" = "1" ]; then
  dev-up "$project_dir"
  if [ "$agent_in_container" = "0" ] && [ "$agent" = "claude" ]; then
    dev-guard --install "$project_dir"
  fi
fi

printf -v quoted_dir '%q' "$project_dir"
printf -v quoted_name '%q' "$session_name"

terminals_command="env -u TMUX tmux -L terminals -f ~/.tmux-terminals.conf new-session -A -s $quoted_name -e DEV_DIR=$quoted_dir dev-in; exec zsh"
side_command="DEV_AGENT=$agent DEV_AGENT_IN_CONTAINER=$agent_in_container $HOME/.local/bin/dev-side $quoted_dir $quoted_name; exec zsh"

if ! tmux has-session -t "=$session_name" 2>/dev/null; then
  editor_pane="$(tmux new-session -d -s "$session_name" -c "$project_dir" -n code \
    -x "$(tput cols)" -y "$(tput lines)" -P -F '#{pane_id}')"
  tmux split-window -h -l 25% -t "$editor_pane" -c "$project_dir" "$side_command"
  tmux split-window -v -l 20% -t "$editor_pane" -c "$project_dir" "$terminals_command"
  tmux send-keys -t "$editor_pane" "DEV_DIR=$quoted_dir dev-in nvim" Enter
  tmux select-pane -t "$editor_pane"
fi

if [ -n "${TMUX:-}" ]; then
  tmux switch-client -t "=$session_name"
else
  tmux attach -t "=$session_name"
fi
