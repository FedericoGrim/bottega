# Names only, never real values. The saved choices live in ~/.config/bottega/config.
# Any of these can also be set for a single command, for example: DEV_ENGINE=docker dev-c-c

# Container engine used by dev-up, dev-in, dctl and dev-stop: podman or docker
DEV_ENGINE=
# Side panel tab for the containers: podman-tui or lazydocker
DEV_PANEL=
# Shell of the panes opened by dev (default: zsh)
DEV_SHELL=
# Project directory used by dev-in (default: the current directory)
DEV_DIR=
# Folder copied into the dev containers (default: ~/.local/share/dev-personal)
DEV_PERSONAL_DIR=
# Folder with the cheatsheet topics (default: ~/.local/share/bottega/cheatsheet)
DEV_CHEATSHEET_DIR=
